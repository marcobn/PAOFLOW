&inputepw
  prefix      = 'pb'
  outdir      = './'
  dvscf_dir   = '../phonon/save'
  amass(1)    = 207.200000
  elph        = .true.
  epbwrite    = .true.
  epbread     = .false.
  epwwrite    = .true.
  epwread     = .false.
  wannierize  = .false.
  nbndsub     = 11
  bands_skipped = 'exclude_bands = 1:5'
  nk1 = 6, nk2 = 6, nk3 = 6
  nq1 = 6, nq2 = 6, nq3 = 6
  nkf1 = 1, nkf2 = 1, nkf3 = 1
  nqf1 = 1, nqf2 = 1, nqf3 = 1
/
