 &control
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'bi2se3'
    pseudo_dir = '../../../PSEUDOS/nc-fr-04_pbe_standard'
    outdir = './output/qe'
    verbosity = 'high'
    tprnfor = .true.
 /
 &system
    ibrav = 4
    A = 4.138
    C = 28.64
    nat = 15, ntyp = 2
    ecutwfc = 80.0
    ecutrho = 320.0
    noncolin = .true.
    lspinorb = .true.
    occupations = 'smearing', smearing = 'marzari-vanderbilt', degauss = 0.005
 /
 &electrons
    mixing_mode = 'plain'
    mixing_beta = 0.3
    conv_thr = 1.0d-8
    electron_maxstep = 200
 /
