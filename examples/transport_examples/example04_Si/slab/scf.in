 &control
    calculation = 'scf'
    prefix='silicon_slab',
    pseudo_dir = '../'
    outdir='./output/qe'
 /
 &system
!   Si(001) slab, 16 atomic planes, unpassivated on both faces.
!   Generated by build_slab.py -- edit NLAYERS there, do not hand-edit this file.
!   Same (1x1) surface cell as the bulk run, so Gamma-Xbar is identical.
    ibrav=  6, celldm(1) = 7.494962771, celldm(3) = 9.305989187,
    nat= 16, ntyp= 1,
    ecutwfc = 18.0,
!   Dangling bonds make the slab metallic.
    occupations = 'smearing', smearing = 'mv', degauss = 0.01
 /
 &electrons
    mixing_mode = 'plain'
    mixing_beta = 0.3
    conv_thr = 1.0d-10
 /
