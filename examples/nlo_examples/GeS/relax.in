 &control
    calculation = 'relax'
    prefix = 'ges'
    outdir = './'
    pseudo_dir = '../../../PSEUDOS/nc-sr-05_pbe_standard_upf/'
    forc_conv_thr = 1.0d-4
    etot_conv_thr = 1.0d-6
    nstep = 80
 /
 &system
    ibrav = 0
    nat = 4
    ntyp = 2
    ecutwfc = 60
    ecutrho = 240
    assume_isolated = '2D'
    occupations = 'fixed'
 /
 &electrons
    conv_thr = 1.0d-10
 /
 &ions
 /
