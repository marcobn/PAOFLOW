# but keep the Rust crate's CI helper scripts (needed by paoflow-rs workflow)
!rust/paoflow_rs/scripts/

# --- Files produced by runs in examples/ ---
# Keep only inputs (*.in, INCAR/KPOINTS/POSCAR, *.py, inputfile.xml, README*)
# and pseudopotentials (*.UPF, POTCAR). Ignore everything generated by a run.

# Quantum ESPRESSO run outputs
examples/**/*.out
examples/**/*.save/
examples/**/*.wfc*
examples/**/*.igk*
examples/**/*.mix*
examples/**/CRASH
examples/**/data-file*.xml
examples/**/atomic_proj.xml
examples/**/charge-density.*
examples/**/spin-polarization.*

# VASP run outputs
examples/**/CHG
examples/**/CHGCAR
examples/**/WAVECAR
examples/**/WAVEDER
examples/**/vasprun.xml
examples/**/OUTCAR
examples/**/DOSCAR
examples/**/EIGENVAL
examples/**/IBZKPT
examples/**/OSZICAR
examples/**/XDATCAR
examples/**/CONTCAR
examples/**/REPORT
examples/**/PROCAR
examples/**/PCDAT
examples/**/LOCPOT
examples/**/ELFCAR

# PAOFLOW outputs / data dumps
examples/**/output/
examples/**/output_*/
examples/**/*.dat
examples/**/*.npy
examples/**/*.npz
examples/**/*.h5
examples/**/*.hdf5
examples/**/*.pdf
examples/**/*.png
examples/**/*.jpg
examples/**/*.eps
examples/**/*.bxsf
examples/**/paoflow.log
examples/**/*.log

# But keep these inputs even if matched above
!examples/**/inputfile.xml
!examples/**/*.in
!examples/**/*.py
!examples/**/*.ipynb
!examples/**/*.md
!examples/**/README*
!examples/**/*.UPF
!examples/**/INCAR
!examples/**/KPOINTS
!examples/**/POSCAR
# Experimental input images of the quantum-oscillation analysis; the BXSF inputs of the pyskeaf case
!examples/cases/nbsn2_qo_analysis/data/*.png
!examples/cases/bi_pyskeaf/bxsf/Fermi_surf_band_*.bxsf
# Keep curated Reference directories (expected outputs for tests/comparison)
!examples/**/Reference/
!examples/**/Reference/**
!examples/**/Reference2/
!examples/**/Reference2/**

# MAC files
.DS_*

# GitHub
# Ignore GitHub SHA files that are generated by the create_assets.sh script. These files contain the commit SHA of the QE and PAOFLOW repositories used to generate the assets, and are not needed in the repository.
SHA*
*_SHA*
**/_assets

# electron-phonon system folders (examples/cases/<system>_elphon)
examples/cases/*_elphon/cache/*
!examples/cases/*_elphon/cache/.gitkeep
examples/cases/*_elphon/*/output*/
examples/cases/*_elphon/qe/*/*.save/
examples/cases/*_elphon/qe/*/_ph0/
examples/cases/*_elphon/qe/*/*.dyn*
examples/cases/*_elphon/qe/*/*.out
examples/cases/*_elphon/qe/*/output/
examples/cases/*_elphon/qe/phonon/quadrupoles/
examples/cases/*_elphon/thermal/zg/

# cases run in place: generated basis tables, pseudopotentials copied next to the inputs, run outputs
examples/cases/*/BASIS_PS/
examples/cases/**/*.upf
examples/cases/**/*.UPF
examples/cases/tbg_unfold/geom_tbg_*.json
examples/cases/tbg_unfold/Carbon_tbg*/
examples/cases/nbsn2_qo_analysis/qo_analysis_*/
examples/cases/bi_pyskeaf/bxsf/paoflow_outputs.json
# VASP pseudopotentials are licensed: never tracked
examples/**/POTCAR

# pw.x output excerpts read by the campaign tests (the global *.out rule kept them out of CI)
!tests/unit/agentic/campaign/data/*.out

# unit-test fixtures: tracked, the QE save and its XML files included (see tests/data/README.md)
!tests/data/**/*.save/
!tests/data/**/*.xml
