Si diamond
 &control
    calculation = 'scf',
    restart_mode = 'from_scratch',
    prefix = 'Si',
    wf_collect = .true.
    pseudo_dir = './'
 /

 &system
    ibrav = 0,
    nat = 2,
    ntyp = 1,
    celldm(1) = 10.599478,
    ecutwfc = 50.0,
    ecutrho = 200.0,
 /

 &electrons
    mixing_mode = 'plain'
    mixing_beta = 0.7
    conv_thr = 1.0d-10
    electron_maxstep = 200
 /

K_POINTS automatic
 8 8 8 0 0 0

ATOMIC_SPECIES
 Si  28.086  Si.pbe-tm-new-gipaw-v2.1.UPF

CELL_PARAMETERS  alat
-0.500000   0.000000   0.500000 
 0.000000   0.500000   0.500000 
-0.500000   0.500000   0.000000 

ATOMIC_POSITIONS crystal
 Si   0.00   0.00   0.00
 Si   0.25   0.25   0.25
