{
 "title": "AlP: Hubbard-corrected bands, transport and dielectric function",
 "summary": "A fixed on-site correction (-U/2 on the Al and P p orbitals, the non-self-consistent ACBN0 values) opens the gap; then DOS, transport and the optical dielectric tensor.",
 "workflow": "run",
 "answers": {
  "savedir": "alp.save",
  "prefix": "alp",
  "projector": "projwfc",
  "properties": [
   "bands",
   "dos",
   "transport",
   "optical",
   "hamiltonian_changes"
  ],
  "ibrav": 2,
  "nk": 2000,
  "do_pdos": false,
  "emin": -8.0,
  "emax": 5.0,
  "interpolate": true,
  "nfft": 24,
  "hubbard_shifts": [
   [
    "2",
    "4",
    "0.1"
   ],
   [
    "18",
    "20",
    "2.31"
   ]
  ]
 },
 "pseudopotentials": [
  "library/Al.pbe-mt_fhi.UPF",
  "library/P.pbe-mt_fhi.UPF"
 ],
 "qe": [
  {
   "program": "pw.x",
   "input": "scf.in",
   "label": "Self-consistent run"
  },
  {
   "program": "pw.x",
   "input": "nscf.in",
   "label": "Non-self-consistent run on the full k grid"
  },
  {
   "program": "projwfc.x",
   "input": "proj.in",
   "label": "Projections on the atomic wavefunctions"
  }
 ],
