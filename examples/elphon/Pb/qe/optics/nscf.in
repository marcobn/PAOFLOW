&CONTROL
  calculation     = 'nscf'
  prefix          = 'pb',
  restart_mode    = 'from_scratch'
  pseudo_dir      = '../',
  outdir          = './'


/
&SYSTEM
  ibrav           = 2,
  celldm(1)       = 9.508849701769328,
  nat             = 1,
  ntyp            = 1,
  ecutwfc         = 60.0
  occupations     = 'smearing',
  smearing        = 'm-p',
  degauss         = 0.04
  nbnd            = 40
/
&ELECTRONS
  diagonalization = 'david'
  mixing_mode     = 'plain'
  mixing_beta     = 0.7
  conv_thr        = 1.0d-18
/
ATOMIC_SPECIES
  Pb 207.2 Pb.upf
ATOMIC_POSITIONS {crystal}
  Pb 0.00 0.00 0.00
K_POINTS {automatic}
  12 12 12 0 0 0
