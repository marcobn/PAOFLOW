 &control
    calculation = 'nscf'
    prefix='silicon',
    pseudo_dir = './'
    outdir='./output/qe'
 /
 &system
    ibrav=  6, celldm(1) = 7.494962771, celldm(3) = 1.414213562,
    nat=  4, ntyp= 1,
    ecutwfc =18.0,  nbnd = 36, nosym=.true.,
    noinv=.true.

 /
 &electrons
    mixing_mode = 'plain'
    mixing_beta = 0.7
    conv_thr =  1.0d-8
 /
ATOMIC_SPECIES
 Si  28.086 Si.pbe-tm-new-gipaw-v2.1.UPF
ATOMIC_POSITIONS (crystal)
 Si 0.00 0.00 0.00
 Si 0.50 0.00 0.25
 Si 0.50 0.50 0.50
 Si 0.00 0.50 0.75
K_POINTS {automatic}
  6 6 6 0 0 0
