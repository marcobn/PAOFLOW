 &control
    calculation = 'nscf'
    prefix      = 'sic'
    pseudo_dir  = '../'
    outdir      = './'
    verbosity   = 'high'
 /
 &system
    ibrav       = 2
    celldm(1)   = 8.237
    nat         = 2
    ntyp        = 2
    ecutwfc     = 60.0
    nbnd        = 12
 /
 &electrons
    conv_thr       = 1.0d-12
    diago_full_acc = .true.
 /
ATOMIC_SPECIES
  Si  28.0855  Si.upf
  C   12.0107  C.upf
ATOMIC_POSITIONS {alat}
  Si  0.00  0.00  0.00
  C   0.25  0.25  0.25
K_POINTS {automatic}
  6 6 6 0 0 0
