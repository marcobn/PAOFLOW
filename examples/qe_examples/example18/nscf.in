&control
  calculation = 'nscf'
  prefix = 'Pd'
  pseudo_dir = './'
  outdir = './'
/
&system
  ibrav = 2
  celldm(1) = 7.3524
  nat = 1
  ntyp = 1
  ecutwfc = 90.0
  input_dft = 'pz'
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  nbnd = 24
  nosym = .true.
  noinv = .true.
/
&electrons
  conv_thr = 1.0d-10
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Pd 106.42 Pd.upf
ATOMIC_POSITIONS (crystal)
  Pd 0.0 0.0 0.0
K_POINTS {automatic}
  12 12 12 0 0 0
